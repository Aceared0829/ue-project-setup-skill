# Copy to the repository root next to <Project>.uproject.
# The compile database is generated by:
#   scripts/ue.sh GenerateClangDatabase
CompileFlags:
  CompilationDatabase: .vscode

  # UBT emits engine-clang / MSVC flags that the local clangd rejects.
  Remove: [-resource-dir, -Werror, -WX, /WX, -mwaitpkg, -fms-hotpatch]
  Add: [-Wno-unknown-warning-option, -Wno-unused-command-line-argument, -D_MSVC_TRADITIONAL=0]

Diagnostics:
  # UE relies on the shared PCH and transitive *.generated.h includes.
  # IncludeCleaner flags CoreMinimal.h as "not used directly"; the offered
  # fix breaks the build, so the diagnostic is off.
  UnusedIncludes: None

  ClangTidy:
    Remove:
      - modernize-*
      - readability-*
      - cppcoreguidelines-*
      - google-*
      - llvm-*
      - misc-*
      - portability-*
      - abseil-*
      - fuchsia-*
      - hicpp-*
      - cert-*
