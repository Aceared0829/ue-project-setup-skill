# Copy to the repository root next to <Project>.uproject.
# The compile database is generated by:
#   scripts/ue.sh GenerateClangDatabase
#
# This key — not --compile-commands-dir in settings.json — selects the database.
# clangd accepts only one --compile-commands-dir value; passing a second one
# silently replaces the first and breaks every include in the other tree.
# A second source tree outside this project (a plugin mirror, a sample host)
# gets its own .clangd in its own directory.
CompileFlags:
  CompilationDatabase: .vscode

  # UBT emits engine-clang / MSVC flags that the local clangd rejects.
  Remove: [-resource-dir, -Werror, -WX, /WX, -mwaitpkg, -fms-hotpatch]
  # UE_LOG token-pastes are errors on a clangd newer than the engine clang.
  # The default 20-error cap then aborts parsing for the rest of the file.
  Add: [-Wno-unknown-warning-option, -Wno-unused-command-line-argument, -D_MSVC_TRADITIONAL=0, -ferror-limit=0]

Diagnostics:
  Suppress:
    - invalid-token-paste
  # UE relies on the shared PCH and transitive *.generated.h includes.
  # IncludeCleaner flags CoreMinimal.h as "not used directly"; the offered
  # fix breaks the build, so the diagnostic is off.
  UnusedIncludes: None

  ClangTidy:
    Remove:
      - modernize-*
      - readability-*
      - cppcoreguidelines-*
      - google-*
      - llvm-*
      - misc-*
      - portability-*
      - abseil-*
      - fuchsia-*
      - hicpp-*
      - cert-*
