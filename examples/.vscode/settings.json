{
  // Do NOT pass --compile-commands-dir here. It is a single-valued flag: give
  // it twice (e.g. host project + a plugin mirror tree) and the last value
  // wins, silently dropping the other. clangd then falls back to flags without
  // include paths and every own header becomes "file not found".
  // The database is selected by <repo>/.clangd instead:
  //   CompileFlags.CompilationDatabase: .vscode
  // A second, non-UBT source tree gets its own .clangd next to its sources.
  //
  // Replace the query-driver path with your engine's Linux clang++ (glob OK).
  "clangd.arguments": [
    "--background-index",
    "--header-insertion=never",
    "--completion-style=detailed",
    "--inlay-hints",
    "--query-driver=/path/to/UE_5.8/Engine/Extras/ThirdPartyNotUE/SDKs/HostLinux/Linux_x64/*/x86_64-unknown-linux-gnu/bin/clang++"
  ],
  "clangd.onConfigChanged": "restart",

  // One language server only; the MS extension cannot read UBT flags.
  "C_Cpp.intelliSenseEngine": "disabled",
  "C_Cpp.errorSquiggles": "disabled",

  "[cpp]": {
    "editor.insertSpaces": false,
    "editor.tabSize": 4,
    "editor.formatOnSave": false
  },

  "files.associations": {
    "*.inl": "cpp"
  },

  "search.exclude": {
    "**/Binaries": true,
    "**/Intermediate": true,
    "**/Saved": true,
    "**/DerivedDataCache": true,
    "**/Plugins/**/ThirdParty/**": true
  },
  "files.watcherExclude": {
    "**/Binaries/**": true,
    "**/Intermediate/**": true,
    "**/Saved/**": true,
    "**/DerivedDataCache/**": true,
    "**/Plugins/**/ThirdParty/**": true
  }
}
