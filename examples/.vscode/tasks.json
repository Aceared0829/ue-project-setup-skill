{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "UE: Build editor (Linux Development)",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/ue.sh", "BuildEditor"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "UE: Regenerate clang database",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/ue.sh", "GenerateClangDatabase"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      // Background watcher: rebuilds the database when source files are added,
      // renamed or removed, and never on content saves. Runs once per folder
      // open; VS Code asks once whether to allow automatic tasks.
      "label": "UE: Watch clang database",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/ue.sh", "WatchClangDatabase"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "runOptions": { "runOn": "folderOpen" },
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "dedicated" }
    },
    {
      "label": "UE: Generate project files (Linux)",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/ue.sh", "GenerateProjectFiles"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "UE: Launch editor",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/ue.sh", "LaunchEditor"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "UE: Check engine setup",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/ue.sh", "Check"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
