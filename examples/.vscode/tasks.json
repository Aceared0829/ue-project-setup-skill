{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "UE: Build editor (Linux Development)",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/ue.sh", "BuildEditor"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "UE: Regenerate clang database",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/ue.sh", "GenerateClangDatabase"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "UE: Generate project files (Linux)",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/ue.sh", "GenerateProjectFiles"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "UE: Launch editor",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/ue.sh", "LaunchEditor"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "UE: Check engine setup",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/ue.sh", "Check"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
